NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Completar cuando creemos la base PostgreSQL. No subir el archivo .env a GitHub.
DATABASE_URL=
# true para conexiones TLS; false solo para PostgreSQL local sin TLS.
DATABASE_SSL=true
# Si el proveedor requiere CA, PEM con saltos de línea escapados como \n.
DATABASE_CA_CERT=
