{
  "name": "aromas-by-pikin",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,API \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "check": "node scripts/check.mjs",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:bundle": "node scripts/build-sql.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "concurrently": "10.0.5"
  }
}
